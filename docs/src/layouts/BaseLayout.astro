---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.tsx';
import GithubLink from '../components/GithubLink.tsx';
import AppSidebar from '../components/AppSidebar.astro';
import { TopNavigationItem } from '@entur/menu';
import { Contrast } from '@entur/layout';

interface Props {
  title: string;
  description?: string;
  proseWidth?: boolean;
  withToc?: boolean;
  fullBleed?: boolean;
}

const {
  title,
  description,
  proseWidth = false,
  withToc = false,
  fullBleed = false,
} = Astro.props;

const contentClass = [
  'app-content',
  proseWidth ? 'app-content--prose' : '',
  withToc ? 'app-content--with-toc' : '',
  fullBleed ? 'app-content--full-bleed' : '',
]
  .filter(Boolean)
  .join(' ');

const here = Astro.url.pathname.replace(/\/+$/, '') || '/';
const sectionActive = (prefix: string) => {
  if (prefix === '/') return here === '/' || here === '/getting-started';
  return here === prefix || here.startsWith(`${prefix}/`);
};

const primaryNav = [
  { label: 'Overview', href: '/', match: '/' },
  { label: 'Skills', href: '/skills', match: '/skills' },
  { label: 'Plugins', href: '/plugins', match: '/plugins' },
  { label: 'Guides', href: '/guides', match: '/guides' },
  { label: 'About', href: '/about', match: '/about' },
];
---

<!doctype html>
<html lang="en" data-color-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Entur AI</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('entur-ai:color-mode');
          var mode =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia &&
                window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.setAttribute('data-color-mode', mode);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class={fullBleed ? 'page--contrast' : ''}>
    <a class="skip-link" href="#main-content">Skip to content</a>

    {fullBleed ? (
      <Contrast as="header" className="app-topbar app-topbar--contrast">
        <a class="app-topbar__brand" href="/" aria-label="Entur AI — home">
          <img
            src="/logo-light.svg"
            alt=""
            class="app-topbar__brand-logo app-topbar__brand-logo--light"
            width="112"
            height="25"
          />
          <img
            src="/logo-dark.svg"
            alt=""
            class="app-topbar__brand-logo app-topbar__brand-logo--dark"
            width="112"
            height="25"
          />
        </a>
        <nav class="app-topbar__nav" aria-label="Primary">
          {primaryNav.map((item) => (
            <TopNavigationItem
              as="a"
              href={item.href}
              active={sectionActive(item.match)}
            >
              {item.label}
            </TopNavigationItem>
          ))}
        </nav>
        <div class="app-topbar__actions">
          <GithubLink client:only="react" />
          <ThemeToggle client:only="react" />
        </div>
      </Contrast>
    ) : (
      <header class="app-topbar">
        <a class="app-topbar__brand" href="/" aria-label="Entur AI — home">
          <img
            src="/logo-light.svg"
            alt=""
            class="app-topbar__brand-logo app-topbar__brand-logo--light"
            width="112"
            height="25"
          />
          <img
            src="/logo-dark.svg"
            alt=""
            class="app-topbar__brand-logo app-topbar__brand-logo--dark"
            width="112"
            height="25"
          />
        </a>
        <nav class="app-topbar__nav" aria-label="Primary">
          {primaryNav.map((item) => (
            <TopNavigationItem
              as="a"
              href={item.href}
              active={sectionActive(item.match)}
            >
              {item.label}
            </TopNavigationItem>
          ))}
        </nav>
        <div class="app-topbar__actions">
          <GithubLink client:only="react" />
          <ThemeToggle client:only="react" />
        </div>
      </header>
    )}

    {!fullBleed && (
      <aside class="app-sidebar-wrap">
        <AppSidebar />
      </aside>
    )}

    <main id="main-content" class={contentClass}>
      <div class="app-content__body">
        <slot />
      </div>
      {withToc && (
        <aside class="app-content__aside" aria-label="Table of contents">
          <slot name="aside" />
        </aside>
      )}
    </main>
  </body>
</html>
