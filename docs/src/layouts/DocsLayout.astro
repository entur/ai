---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';
import { Heading1, Label, LeadParagraph } from '@entur/typography';

interface Props {
  title: string;
  description?: string;
  sectionLabel?: string;
  prose?: boolean;
  headings?: MarkdownHeading[];
  section?: 'overview' | 'guides' | 'plugins' | 'skills';
}

const {
  title,
  description,
  sectionLabel,
  prose = true,
  headings = [],
  section,
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= 2;
---

<BaseLayout
  title={title}
  description={description}
  proseWidth={prose}
  withToc={showToc}
  section={section}
>
  {sectionLabel && <Label style={{ textTransform: 'uppercase' }}>{sectionLabel}</Label>}
  <Heading1>{title}</Heading1>
  {description && <LeadParagraph>{description}</LeadParagraph>}
  {prose ? (
    <article class="docs-prose">
      <slot />
    </article>
  ) : (
    <slot />
  )}
  {showToc && (
    <Fragment slot="aside">
      <TableOfContents headings={tocHeadings} />
    </Fragment>
  )}
</BaseLayout>
