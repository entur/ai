---
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.tsx';
import type { TocHeading } from '../components/TableOfContents.tsx';
import { Label } from '@entur/typography';

interface Props {
  title: string;
  description?: string;
  sectionLabel?: string;
  prose?: boolean;
  headings?: TocHeading[];
}

const {
  title,
  description,
  sectionLabel,
  prose = true,
  headings = [],
} = Astro.props;

const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const showToc = tocHeadings.length >= 2;
---

<BaseLayout
  title={title}
  description={description}
  proseWidth={prose}
  withToc={showToc}
>
  {sectionLabel && <Label style={{ textTransform: 'uppercase' }}>{sectionLabel}</Label>}
  {prose ? (
    <article class="docs-prose">
      <slot />
    </article>
  ) : (
    <slot />
  )}
  {showToc && (
    <Fragment slot="aside">
      <TableOfContents client:load headings={tocHeadings} />
    </Fragment>
  )}
</BaseLayout>
