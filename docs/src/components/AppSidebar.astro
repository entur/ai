---
import { getCollection } from 'astro:content';
import { SidebarFilter } from './SidebarFilter';
import type { NavGroup } from './SidebarFilter';

interface Props {
  section: 'overview' | 'guides' | 'plugins' | 'skills';
}

const { section } = Astro.props;

let groups: NavGroup[] = [];

if (section === 'overview') {
  groups = [
    {
      title: 'Overview',
      items: [
        { label: 'Getting started', href: '/getting-started' },
        { label: 'About', href: '/about' },
      ],
    },
  ];
} else if (section === 'skills') {
  const skills = (await getCollection('skills')).sort((a, b) =>
    a.data.title.localeCompare(b.data.title),
  );
  groups = [
    {
      title: 'Introduction',
      items: [{ label: 'All skills', href: '/skills' }],
    },
    {
      title: 'Skills',
      items: skills.map((s) => ({ label: s.data.title, href: `/skills/${s.id}` })),
    },
  ];
} else if (section === 'plugins') {
  const plugins = (await getCollection('plugins')).sort((a, b) =>
    a.data.title.localeCompare(b.data.title),
  );
  groups = [
    {
      title: 'Introduction',
      items: [{ label: 'All plugins', href: '/plugins' }],
    },
    {
      title: 'Plugins',
      items: plugins.map((p) => ({ label: p.data.title, href: `/plugins/${p.id}` })),
    },
  ];
} else if (section === 'guides') {
  const guides = (await getCollection('guides'))
    .filter((g) => g.id !== 'about')
    .sort((a, b) => a.data.title.localeCompare(b.data.title));
  groups = [
    {
      title: 'Introduction',
      items: [{ label: 'All guides', href: '/guides' }],
    },
    {
      title: 'Guides',
      items: guides.map((g) => ({ label: g.data.title, href: `/guides/${g.id}` })),
    },
  ];
}
---

<SidebarFilter client:load groups={groups} />
