---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { CodeText, Paragraph } from '@entur/typography';
import { NavigationCard } from '@entur/layout';

const guides = (await getCollection('guides'))
  .filter((g) => g.id !== 'about')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<DocsLayout
  title="Guides"
  prose={false}
  section="guides"
>
  <Paragraph>Cross-cutting platform conventions, sourced from <CodeText>/guides</CodeText>.</Paragraph>
  <div class="card-grid">
    {guides.map((g) => (
      <NavigationCard as="a" href={`/guides/${g.id}`} title={g.data.title}>
        {g.data.description}
      </NavigationCard>
    ))}
  </div>
</DocsLayout>
