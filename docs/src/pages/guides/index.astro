---
import { getCollection } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { Heading1, Paragraph } from '@entur/typography';
import { NavigationCard } from '@entur/layout';
import { firstSentence } from '../../lib/text.ts';

const guides = (await getCollection('guides'))
  .filter((g) => g.id !== 'about')
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<DocsLayout
  title="Guides"
  prose={false}
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Guides' }]}
>
  <Heading1>Guides</Heading1>
  <Paragraph>Cross-cutting platform conventions, sourced from <code>/guides</code>.</Paragraph>
  <div class="card-grid">
    {guides.map((g) => (
      <NavigationCard as="a" href={`/guides/${g.id}`} title={g.data.title}>
        {firstSentence(g.data.description) || g.id}
      </NavigationCard>
    ))}
  </div>
</DocsLayout>
