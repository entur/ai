---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Contrast, NavigationCard } from '@entur/layout';
import { Heading1, Heading2, LeadParagraph, Paragraph } from '@entur/typography';
---

<BaseLayout title="Entur AI" description="Entur AI agent skills, plugins, and platform guides.">
  <Contrast as="section" className="hero">
    <div class="hero__inner">
      <Heading1 margin="none">Entur AI</Heading1>
      <LeadParagraph>
        Skills, plugins, and platform guides for Entur AI agents. Built on the Linje design system.
      </LeadParagraph>
      <Paragraph>
        Use these to bootstrap services, scaffold workflows, and follow Entur platform conventions.
      </Paragraph>
    </div>
  </Contrast>

  <section style="margin-top: 48px;">
    <Heading2>Browse</Heading2>
    <div class="card-grid">
      <NavigationCard as="a" href="/skills" title="Skills">
        Reusable agent skills, organised by domain.
      </NavigationCard>
      <NavigationCard as="a" href="/plugins" title="Plugins">
        Curated bundles of skills installed together.
      </NavigationCard>
      <NavigationCard as="a" href="/guides" title="Guides">
        Cross-cutting platform conventions and standards.
      </NavigationCard>
    </div>
  </section>
</BaseLayout>
