---
import { getCollection, render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { Heading1 } from '@entur/typography';
import { MdxComponents } from '../../components/MdxComponents';

export async function getStaticPaths() {
  const entries = await getCollection('plugins');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props as { entry: Awaited<ReturnType<typeof getCollection<'plugins'>>>[number] };
const { Content, headings } = await render(entry);
const showToc = !entry.data.removeToc;
---

<DocsLayout
  title={entry.data.title}
  description={entry.data.description}
  headings={showToc ? headings : []}
  sectionLabel="Plugins"
>
  <Heading1>{entry.data.title}</Heading1>
  <Content components={MdxComponents} />
</DocsLayout>
